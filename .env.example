# Candix — ejemplo de entorno (copiar a .env)
# Python puro funciona sin Go; definir estas vars activa el motor dual a la par.

# ── Engine bridge (subprocess Go) ──
CANDIX_ENGINE_ENABLED=0
CANDIX_ENGINE_PARALLEL=1
CANDIX_ENGINE_URL=http://127.0.0.1:8787
CANDIX_ENGINE_TIMEOUT=4.0
CANDIX_ENGINE_BRIDGE_BIN=
CANDIX_ENGINE_PG_DSN=postgres://candix:candix@localhost:5432/candix?sslmode=disable
# CANDIX_ENGINE_TRUSTED_PROXIES=
# CANDIX_ENGINE_NOISE_PROFILE=off  # off|quiet|balanced|aggressive
# CANDIX_ENGINE_TARGET_USER_AGENT=
# CANDIX_ENGINE_TASK_BUDGET_TOKENS=  # 0 = unlimited
# CANDIX_ENGINE_TASK_BUDGET_TURNS=
# CANDIX_ENGINE_INTENT_BUDGET_TOKENS=
# CANDIX_ENGINE_INTENT_BUDGET_TURNS=

# ── LLM ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_MODEL=gpt-4o

# ── Notificaciones extendidas (engine/notify) ──
# DINGTALK_WEBHOOK=
# FEISHU_WEBHOOK=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── MCP remoto (engine/mcphttp) ──
# MCP_SERVER_URL=http://127.0.0.1:3000/mcp
